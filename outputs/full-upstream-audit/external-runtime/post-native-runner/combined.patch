+    assert_eq!(
+        check_image_limits(&plan, TextureType::Type2DMultisample, &roomy),
+        Ok(())
+    );
+    let narrow = vk::ImageFormatProperties {
+        max_extent: vk::Extent3D {
+            width: 4,
+            height: 16384,
+            depth: 1,

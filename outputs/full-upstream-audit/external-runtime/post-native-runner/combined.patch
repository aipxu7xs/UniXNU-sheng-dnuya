-    /// `shufflevector a, b, mask`, typed `ty`: lane `i` is lane `mask[i]` of `a` then `b`, and a
-    /// `None` lane is `poison`.
-    pub fn shuffle(
-        &mut self,
-        ty: TypeId,
-        a: ConstId,
-        b: ConstId,
-        mask: &[Option<u32>],
-        m: &mut Meter,
-    ) -> Result<Option<ConstId>, Error> {
-        self.transient(m, |f, m| f.shuffle_in(ty, a, b, mask, m))
-    }

+    for (g, init) in inits {
+        let global = parts
+            .globals
+            .get_mut(g)
+            .ok_or_else(|| invariant("global out of range"))?;
+        global.init = Some(init);
+        global.constant = true;
+        global.externally_initialized = false;
+    }
+    Ok(evaluated)

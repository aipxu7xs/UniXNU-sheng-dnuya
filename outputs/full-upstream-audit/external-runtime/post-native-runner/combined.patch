-                assert_eq!(off.own_image_usage(), usage, "{name}");
-                assert_eq!(on.own_image_usage(), usage, "{name}");
-                let own = plan_image(&l, off.own_image_usage(), false, &facts).expect(&name);
-                assert_eq!(own, optimized, "{name} {pf:?}");

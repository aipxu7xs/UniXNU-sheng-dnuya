-        let Some((first, rest)) = idx.split_first() else {
-            return Ok(0);
-        };
-        let size = self.layouts.alloc_size(src_ty).ok_or_else(err)?;
-        let mut off = index(first)?
-            .checked_mul(i64::try_from(size).map_err(|_| err())?)

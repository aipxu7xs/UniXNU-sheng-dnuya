+        ep.stage = Stage::Vertex { patch: None };
+        ep.outputs = vec![OutputBinding {
+            field: 0,
+            role: OutputRole::VertexOutput(UserKey(b"x".as_slice().into())),
+            shared: false,
+            predicate: gate_output.then_some(off),
+            ty: ArgTypeInfo::default(),
+            name: None,

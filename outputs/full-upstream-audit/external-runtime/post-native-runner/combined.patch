+/// Why the driver did not make a draw's `VkPipeline` ([`CommandBufferError::PipelineCreation`]).
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PipelineCreationCause {
+    /// The device ran out of memory of this kind.

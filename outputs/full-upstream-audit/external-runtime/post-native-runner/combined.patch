+            Error::OutOfMemory(kind) => PipelineCreationCause::OutOfMemory(*kind),
+            Error::DeviceLost => PipelineCreationCause::DeviceLost,
+            Error::Vulkan(code) => PipelineCreationCause::Vulkan(*code),
+            _ => PipelineCreationCause::Internal,

-    /// The byte offset of `getelementptr src_ty, _, idx...` (constant indices only).
-    fn offset(&self, src_ty: TypeId, idx: &[SVal], at: &Location) -> Result<u64, Error> {
-        let err = || not_evaluable(at.clone());

-    let gated = ParamBinding {
-        predicate: Some(Predicate {
-            global: pred,
-            name: DiagName::new("pred"),
-        }),
-        ..buffer(1, 1)
-    };
-    let abi = abi(
-        vec![kernel(k, vec![buffer(0, 0), gated])],
-        vec![fc_decl(0, flag, i8t)],

+//! MSL 4.1's generic pointers, each given the one address space its pointers come from.
+//!
+//! A pointer of the generic space (`addrspace(8)`) is a device, thread or threadgroup pointer a
+//! cast made generic: it keeps pointing into that space, and
+//! `air.is_{device,thread,threadgroup}_pointer` asks which. Vulkan's logical addressing has no
+//! pointer that may point into either of two storage classes, so each generic pointer of the
+//! inlined entry becomes a pointer of the one space every pointer it may hold comes from.
+//!
+//! Generic pointers that must share a type share a space: a `getelementptr`, `bitcast`,
+//! `addrspacecast` or `freeze` of a generic pointer and its operand, a `phi` or `select` and its
+//! operands, the two sides of an `icmp`, the generic pointers stored into and loaded from one
+//! slot of thread memory whose every access the translation sees, and a slot and the slot a copy
+//! of its bytes moves it to ([`cells`]), and a generic
+//! pointer an aggregate or a vector value holds (a *leaf*) and what it comes from ([`leaves`]).
+//! The links are the union-find of [`plan()`]. Each such group has one space where every pointer
+//! entering it does:
+//!
+//! - an `addrspacecast` from a pointer of a device, thread or threadgroup space brings in that
+//!   space, and so does a constant expression of such a cast;
+//! - a null, undefined or poison constant brings in none: it points nowhere;
+//! - a generic pointer a call, an `inttoptr`, an atomic or a load from other memory gives, or a
+//!   parameter, brings in a space only the run knows, and so does an aggregate a load or a call
+//!   gives for each of its leaves.
+//!
+//! A group that pointers of two spaces enter, or one a space only the run knows, is
+//! `Unsupported{GenericPointer(..)}` at the instruction where it does, naming how
+//! ([`GenericPointer`]): no Vulkan pointer holds either. So is a generic pointer passed to a call
+//! other than a query (the callee's type names the generic space) or returned, alone or in an
+//! aggregate (`Call`).
+//!
+//! Each generic pointer then is its group's pointer type, and a group that no space enters a
+//! thread pointer (it addresses nothing); an aggregate or a vector value's type is its type with
+//! each leaf its group's pointer. A cast into the generic space is its operand. A cast out of it
+//! is its operand where it names the group's space, and poison where it names another (an
+//! `addrspacecast` of a pointer not of the space it names is poison). Every other instruction
+//! keeps its operation, its generic constants those of its group's type (a store's, its value's
+//! group's; an aggregate constant's, its leaves'). A query is false for another space; for the
+//! group's own space it is true, or, where a null constant may reach the pointer (through thread
+//! memory and aggregates too), whether the pointer is not null, as Metal answers no space for a
+//! null generic pointer. That answer is the pointer's structure's where it decides it: a
+//! variable's or a global's address, a cast of one or an in-bounds step from one is not null, a
+//! null constant is, and a `select` between two such pointers is not null where its condition
+//! picks the one that is not. Else it is a comparison with the null pointer of the group's space.
+//! A generic pointer that only answered queries read goes, with what only it reads. Aggregate
+//! types that hold generic pointers in memory (an `alloca`'s or a `getelementptr`'s source type)
+//! keep them: they lay out bytes, and a pointer of every space is 64 bits.
+
+use crate::budget::Meter;
+use crate::error::{DiagName, Error, Feature, GenericPointer, Location, Unsupported};
+use crate::intrinsics::AirIntrinsic;
+use crate::ir::{AddrSpace, Body, Callee, CastOp, Const, ConstExpr, ConstId, Constant, FastMath};
+use crate::ir::{FuncId, Idx, InstId, InstKind, IntPredicate, ModuleParts, Type, TypeId, Value};
+
+use super::rewrite::{apply, filled, invariant, scoped, BodyEdit};
+
+mod cells;
+mod leaves;
+mod plan;
+
+use plan::{plan, Plan};
+
+/// The most aggregate levels searched for a generic pointer in a type.
+const DEPTH: u32 = 32;
+
+/// The pointers a group of generic pointers may hold.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Space {
+    /// None yet: only constants that point nowhere.
+    Unseen,
+    /// Pointers of this space.
+    One(AddrSpace),
+    /// Pointers of two spaces, or of a space only the run knows: how, and the instruction where
+    /// it entered, where one did.
+    Many(GenericPointer, Option<InstId>),
+}
+
+impl Space {
+    /// The space of a group that both `self` and `other` enter, at instruction `at`.
+    fn join(self, other: Space, at: Option<InstId>) -> Space {
+        match (self, other) {
+            (Space::Unseen, s) | (s, Space::Unseen) => s,
+            (Space::One(a), Space::One(b)) if a == b => Space::One(a),
+            (m @ Space::Many(..), _) | (_, m @ Space::Many(..)) => m,
+            _ => Space::Many(GenericPointer::TwoSpaces, at),
+        }
+    }
+}
+
+/// A generic pointer refused for `how`, where no instruction locates it.
+fn refused(how: GenericPointer) -> Error {
+    Unsupported::not_implemented(Feature::GenericPointer(how)).into()
+}
+
+/// The entry's name, body and parameter types, and the module's tables.
+struct Cx<'a> {
+    name: &'a DiagName,
+    body: &'a Body,
+    parts: &'a ModuleParts,
+    params: &'a [TypeId],
+}
+
+impl Cx<'_> {
+    /// A generic pointer refused for `how`, at instruction `at` of the entry.
+    fn refuse(&self, how: GenericPointer, at: InstId) -> Error {
+        let block = self
+            .body
+            .blocks
+            .iter()
+            .find(|(_, b)| b.start <= at && at < b.end)
+            .map(|(b, _)| b.raw());
+        Unsupported::not_implemented(Feature::GenericPointer(how))
+            .at(Location::function(self.name.clone(), block, Some(at.raw())))
+            .into()
+    }
+
+    fn generic(&self, ty: TypeId) -> bool {
+        matches!(
+            self.parts.types.get(ty),
+            Some(Type::Ptr {
+                space: AddrSpace::Generic
+            })
+        )
+    }
+
+    fn ty(&self, v: Value) -> Option<TypeId> {
+        match v {
+            Value::Inst(i) => self.body.insts.get(i).map(|inst| inst.ty),
+            Value::Const(c) => self.parts.consts.ty(c),
+            Value::Arg(a) => self.params.get(a.index()).copied(),
+        }
+    }
+
+    fn is_generic(&self, v: Value) -> bool {
+        self.ty(v).is_some_and(|t| self.generic(t))
+    }
+
+    /// Whether `ty` holds a generic pointer below an aggregate or vector level.
+    fn holds_generic(&self, ty: TypeId, depth: u32) -> Result<bool, Error> {
+        if depth > DEPTH {
+            return Err(refused(GenericPointer::Aggregate));
+        }
+        Ok(match self.parts.types.get(ty) {
+            Some(Type::Vector { elem, .. } | Type::Array { elem, .. }) => {
+                self.generic(*elem) || self.holds_generic(*elem, depth + 1)?
+            }
+            Some(Type::Struct { fields, .. }) => {
+                let mut any = false;
+                for &f in fields.iter() {
+                    any |= self.generic(f) || self.holds_generic(f, depth + 1)?;
+                }
+                any
+            }
+            _ => false,
+        })
+    }
+
+    /// The space a generic constant brings in, and whether it is null.
+    fn constant(&self, c: ConstId, depth: u32) -> Result<(Space, bool), Error> {
+        if depth > DEPTH {
+            return Err(refused(GenericPointer::Integer));
+        }
+        let k = self
+            .parts
+            .consts
+            .get(c)
+            .ok_or_else(|| invariant("a constant out of range"))?;
+        Ok(match &k.value {
+            Const::Null => (Space::Unseen, true),
+            Const::Undef | Const::Poison => (Space::Unseen, false),
+            Const::Expr(ConstExpr::Cast {
+                op: CastOp::AddrSpaceCast | CastOp::Bitcast,
+                ops: [o],
+            }) => {
+                let ty = self
+                    .parts
+                    .consts
+                    .ty(*o)
+                    .ok_or_else(|| invariant("a constant"))?;
+                match self.parts.types.get(ty) {
+                    Some(Type::Ptr {
+                        space: AddrSpace::Generic,
+                    }) => self.constant(*o, depth + 1)?,
+                    Some(Type::Ptr { space }) => (
+                        Space::One(*space),
+                        matches!(
+                            self.parts.consts.get(*o).map(|k| &k.value),
+                            Some(Const::Null)
+                        ),
+                    ),
+                    _ => (Space::Many(GenericPointer::Integer, None), false),
+                }
+            }
+            Const::Expr(ConstExpr::Gep { ops, .. }) => match ops.first() {
+                Some(&base) => self.constant(base, depth + 1)?,
+                None => (Space::Many(GenericPointer::Integer, None), false),
+            },
+            _ => (Space::Many(GenericPointer::Integer, None), false),
+        })
+    }
+
+    /// Whether pointer `v` (of any space) is not null where its structure decides it: a variable's
+    /// or a global's address, a cast of one, or an in-bounds step from one is not null; a null,
+    /// undefined or poison constant points nowhere. `None` where only the run knows.
+    fn nonnull(&self, v: Value, depth: u32) -> Option<bool> {
+        if depth > DEPTH {
+            return None;
+        }
+        match v {
+            Value::Const(c) => self.nonnull_constant(c, depth),
+            Value::Arg(_) => None,
+            Value::Inst(i) => match &self.body.insts.get(i)?.kind {
+                InstKind::Alloca { .. } => Some(true),
+                InstKind::Gep {
+                    base,
+                    inbounds: true,
+                    ..
+                } => self.nonnull(*base, depth + 1),
+                InstKind::Cast {
+                    op: CastOp::Bitcast | CastOp::AddrSpaceCast,
+                    v,
+                }
+                | InstKind::Freeze(v) => self.nonnull(*v, depth + 1),
+                _ => None,
+            },
+        }
+    }
+
+    /// [`Cx::nonnull`] of constant `c`.
+    fn nonnull_constant(&self, c: ConstId, depth: u32) -> Option<bool> {
+        if depth > DEPTH {
+            return None;
+        }
+        match &self.parts.consts.get(c)?.value {
+            Const::Null | Const::Undef | Const::Poison => Some(false),
+            Const::GlobalAddr(_) => Some(true),
+            Const::Expr(ConstExpr::Cast {
+                op: CastOp::AddrSpaceCast | CastOp::Bitcast,
+                ops: [o],
+            }) => self.nonnull_constant(*o, depth + 1),
+            Const::Expr(ConstExpr::Gep {
+                inbounds: true,
+                ops,
+                ..
+            }) => self.nonnull_constant(*ops.first()?, depth + 1),
+            _ => None,
+        }
+    }
+
+    /// Whether generic pointer `p` is not null, as far as its structure decides it: by itself, or
+    /// as a `select` between two pointers it decides.
+    fn not_null(&self, p: Value) -> NotNull {
+        if let Some(b) = self.nonnull(p, 0) {
+            return NotNull::Is(b);
+        }
+        if let Value::Inst(i) = p {
+            if let Some(InstKind::Select { c, t, f, .. }) = self.body.insts.get(i).map(|x| &x.kind)
+            {
+                if let (Some(t), Some(f)) = (self.nonnull(*t, 0), self.nonnull(*f, 0)) {
+                    return if t == f {
+                        NotNull::Is(t)
+                    } else {
+                        NotNull::When { c: *c, t }
+                    };
+                }
+            }
+        }
+        NotNull::Run
+    }
+
+    /// The space and nullness a generic operand brings in by itself: a constant's, `Many` for a
+    /// parameter, nothing for an instruction (its group carries it).
+    fn operand(&self, v: Value) -> Result<(Space, bool), Error> {
+        match v {
+            Value::Const(c) => self.constant(c, 0),
+            Value::Arg(_) => Ok((Space::Many(GenericPointer::Call, None), false)),
+            Value::Inst(_) => Ok((Space::Unseen, false)),
+        }
+    }
+}
+
+/// Whether a generic pointer is not null.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum NotNull {
+    /// Its structure decides it.
+    Is(bool),
+    /// A `select` on `c` decides it: `t` where `c` holds, the other answer where not.
+    When { c: Value, t: bool },
+    /// Only the run knows.
+    Run,
+}
+
+/// `body` with every generic pointer a pointer of its group's space (module docs), and whether a
+/// query folded (SCCP then folds what it decides). `func` is the entry whose body it is.
+pub(super) fn resolve(
+    body: Body,
+    parts: &mut ModuleParts,
+    func: FuncId,
+    name: &DiagName,
+    m: &mut Meter,
+) -> Result<(Body, bool), Error> {
+    let params: Vec<TypeId> = match parts.funcs.get(func).and_then(|f| parts.types.get(f.ty)) {
+        Some(Type::Function { params, .. }) => params.to_vec(),
+        _ => return Err(invariant("the entry's type is not a function")),
+    };
+    let planned = scoped(m, |m, held| {
+        let cx = Cx {
+            name,
+            body: &body,
+            parts,
+            params: &params,
+        };
+        plan(&cx, m, held)
+    })?;
+    let Some(plan) = planned else {
+        return Ok((body, false));
+    };
+    let edited = scoped(m, |m, held| {
+        rewrite(&body, parts, (name, &params), &plan, m, held)
+    })?;
+    body.release(m);
+    Ok((edited, plan.folds))
+}
+
+/// Whether `kind` is a query or a comparison of generic pointers, whose space is its pointer's,
+/// or a store of a generic pointer, whose space is its value's.
+fn shares(cx: &Cx<'_>, kind: &InstKind) -> bool {
+    match kind {
+        InstKind::Call(call) => matches!(
+            call.callee,
+            Callee::Air {
+                op: AirIntrinsic::PointerSpace(_),
+                ..
+            }
+        ),
+        InstKind::ICmp { a, b, .. } => cx.is_generic(*a) && cx.is_generic(*b),
+        InstKind::Store { val, .. } => cx.is_generic(*val),
+        _ => false,
+    }
+}
+
+/// The interned pointer types and constants the rewrite names.
+struct Interned {
+    ptrs: Vec<(AddrSpace, TypeId)>,
+}
+
+impl Interned {
+    fn ptr(
+        &mut self,
+        parts: &mut ModuleParts,
+        s: AddrSpace,
+        m: &mut Meter,
+    ) -> Result<TypeId, Error> {
+        if let Some(&(_, t)) = self.ptrs.iter().find(|(x, _)| *x == s) {
+            return Ok(t);
+        }
+        let t = parts.types.intern(Type::Ptr { space: s }, m)?;
+        self.ptrs.push((s, t));
+        Ok(t)
+    }
+}
+
+/// Generic constant `c` as a constant of space `s`.
+fn retyped(
+    parts: &mut ModuleParts,
+    interned: &mut Interned,
+    c: ConstId,
+    s: AddrSpace,
+    depth: u32,
+    m: &mut Meter,
+) -> Result<ConstId, Error> {
+    if depth > DEPTH {
+        return Err(refused(GenericPointer::Integer));
+    }
+    let k = parts
+        .consts
+        .get(c)
+        .cloned()
+        .ok_or_else(|| invariant("a constant out of range"))?;
+    let ty = interned.ptr(parts, s, m)?;
+    let value = match k.value {
+        v @ (Const::Null | Const::Undef | Const::Poison) => v,
+        Const::Expr(ConstExpr::Cast {
+            op: CastOp::AddrSpaceCast | CastOp::Bitcast,
+            ops: [o],
+        }) => {
+            let oty = parts.consts.ty(o).ok_or_else(|| invariant("a constant"))?;
+            return match parts.types.get(oty) {
+                Some(Type::Ptr {
+                    space: AddrSpace::Generic,
+                }) => retyped(parts, interned, o, s, depth + 1, m),
+                Some(Type::Ptr { space }) if *space == s => Ok(o),
+                Some(Type::Ptr { .. }) => Err(refused(GenericPointer::TwoSpaces)),
+                _ => Err(refused(GenericPointer::Integer)),
+            };
+        }
+        Const::Expr(ConstExpr::Gep {
+            src_ty,
+            inbounds,
+            ops,
+        }) => {
+            let (&base, rest) = ops
+                .split_first()
+                .ok_or_else(|| refused(GenericPointer::Integer))?;
+            let base = retyped(parts, interned, base, s, depth + 1, m)?;
+            let ops: Box<[ConstId]> = std::iter::once(base).chain(rest.iter().copied()).collect();
+            Const::Expr(ConstExpr::Gep {
+                src_ty,
+                inbounds,
+                ops,
+            })
+        }
+        _ => return Err(refused(GenericPointer::Integer)),
+    };
+    parts.consts.intern(Constant { ty, value }, m)
+}
+
+/// The space a group of `space` takes: its own, or thread where none entered it.
+fn taken(space: Space) -> AddrSpace {
+    match space {
+        Space::One(s) => s,
+        _ => AddrSpace::Thread,
+    }
+}
+
+fn rewrite(
+    body: &Body,
+    parts: &mut ModuleParts,
+    (name, params): (&DiagName, &[TypeId]),
+    plan: &Plan,
+    m: &mut Meter,
+    held: &mut usize,
+) -> Result<Body, Error> {
+    let mut edit = BodyEdit::keep_all(body, m, held)?;
+    let mut interned = Interned { ptrs: Vec::new() };
+    let i1 = parts.types.intern(Type::Int(1), m)?;
+    let boolean = |parts: &mut ModuleParts, b: bool, m: &mut Meter| {
+        parts.consts.intern(
+            Constant {
+                ty: i1,
+                value: Const::Int(u64::from(b)),
+            },
+            m,
+        )
+    };
+    for (i, inst) in body.insts.iter() {
+        m.tick(1)?;
+        let generic_of = |parts: &ModuleParts, v: Value| -> bool {
+            let ty = match v {
+                Value::Inst(j) => body.insts.get(j).map(|x| x.ty),
+                Value::Const(c) => parts.consts.ty(c),
+                Value::Arg(a) => params.get(a.index()).copied(),
+            };
+            matches!(
+                ty.and_then(|t| parts.types.get(t)),
+                Some(Type::Ptr {
+                    space: AddrSpace::Generic
+                })
+            )
+        };
+        let result_generic = matches!(
+            parts.types.get(inst.ty),
+            Some(Type::Ptr {
+                space: AddrSpace::Generic
+            })
+        );
+        let own = plan.space.get(i.index()).copied().unwrap_or(Space::Unseen);
+        // An aggregate or a vector that holds generic pointers: its leaves' spaces.
+        if let Some(leaves) = plan.leaves.as_ref() {
+            if let Some(at) = leaves.of(i, parts, inst.ty) {
+                let mut r = leaves::Retyped {
+                    leaves,
+                    interned: &mut interned,
+                };
+                leaves::rewrite(parts, &mut r, &plan.leaf_space, (i, inst), at, &mut edit, m)?;
+                continue;
+            }
+        }
+        // A cast into the generic space, or a no-op cast within it, is its operand.
+        if let InstKind::Cast {
+            op: CastOp::AddrSpaceCast | CastOp::Bitcast,
+            v,
+        } = inst.kind
+        {
+            let from_generic = generic_of(parts, v);
+            if result_generic {
+                let s = taken(own);
+                let v = match v {
+                    Value::Const(c) if from_generic => {
+                        Value::Const(retyped(parts, &mut interned, c, s, 0, m)?)
+                    }
+                    other => other,
+                };
+                edit.replace(i, v);
+                continue;
+            }
+            if from_generic {
+                // A cast out of the generic space: its operand where it names the group's space,
+                // else poison.
+                let to = match parts.types.get(inst.ty) {
+                    Some(Type::Ptr { space }) => *space,
+                    _ => return Err(refused(GenericPointer::Integer)),
+                };
+                let group = match v {
+                    Value::Inst(j) => plan.space.get(j.index()).copied().unwrap_or(Space::Unseen),
+                    Value::Const(c) => {
+                        Cx {
+                            name,
+                            body,
+                            parts,
+                            params,
+                        }
+                        .constant(c, 0)?
+                        .0
+                    }
+                    Value::Arg(_) => return Err(refused(GenericPointer::Call)),
+                };
+                let value = match group {
+                    // A pointer computed from no pointer, made a pointer of another space.
+                    Space::Unseen if to != AddrSpace::Thread && matches!(v, Value::Inst(_)) => {
+                        let poison = parts.consts.intern(
+                            Constant {
+                                ty: inst.ty,
+                                value: Const::Poison,
+                            },
+                            m,
+                        )?;
+                        Value::Const(poison)
+                    }
+                    Space::One(s) if s != to => {
+                        let poison = parts.consts.intern(
+                            Constant {
+                                ty: inst.ty,
+                                value: Const::Poison,
+                            },
+                            m,
+                        )?;
+                        Value::Const(poison)
+                    }
+                    Space::Many(how, _) => return Err(refused(how)),
+                    _ => match v {
+                        Value::Const(c) => {
+                            Value::Const(retyped(parts, &mut interned, c, to, 0, m)?)
+                        }
+                        other => other,
+                    },
+                };
+                edit.replace(i, value);
+                continue;
+            }
+        }
+        // A query: false for another space; true, or not null, for its group's own.
+        if let InstKind::Call(call) = &inst.kind {
+            if let Callee::Air {
+                op: AirIntrinsic::PointerSpace(q),
+                ..
+            } = call.callee
+            {
+                let p = *call
+                    .args
+                    .first()
+                    .ok_or_else(|| invariant("a query's pointer"))?;
+                let (s, nullable) = match p {
+                    Value::Inst(j) => (
+                        plan.space.get(j.index()).copied().unwrap_or(Space::Unseen),
+                        plan.null.get(j.index()).copied().unwrap_or(true),
+                    ),
+                    Value::Const(c) => Cx {
+                        name,
+                        body,
+                        parts,
+                        params,
+                    }
+                    .constant(c, 0)?,
+                    Value::Arg(_) => return Err(refused(GenericPointer::Call)),
+                };
+                let decided = Cx {
+                    name,
+                    body,
+                    parts,
+                    params,
+                }
+                .not_null(p);
+                match (s, decided) {
+                    (Space::One(s), NotNull::Is(b)) if s == q.space && nullable => {
+                        edit.replace(i, Value::Const(boolean(parts, b, m)?));
+                    }
+                    (Space::One(s), NotNull::When { c, t: true }) if s == q.space && nullable => {
+                        edit.replace(i, c);
+                    }
+                    (Space::One(s), NotNull::When { c, t: false }) if s == q.space && nullable => {
+                        let (t, f) = (boolean(parts, false, m)?, boolean(parts, true, m)?);
+                        edit.rewrite.insert(
+                            i,
+                            InstKind::Select {
+                                c,
+                                t: Value::Const(t),
+                                f: Value::Const(f),
+                                fmf: FastMath::NONE,
+                            },
+                        );
+                    }
+                    (Space::One(s), _) if s == q.space && nullable => {
+                        let null = Value::Const(retyped_null(parts, &mut interned, s, m)?);
+                        let a = match p {
+                            Value::Const(c) => {
+                                Value::Const(retyped(parts, &mut interned, c, s, 0, m)?)
+                            }
+                            other => other,
+                        };
+                        edit.rewrite.insert(
+                            i,
+                            InstKind::ICmp {
+                                pred: IntPredicate::Ne,
+                                a,
+                                b: null,
+                            },
+                        );
+                    }
+                    (Space::One(s), _) => {
+                        edit.replace(i, Value::Const(boolean(parts, s == q.space, m)?));
+                    }
+                    (Space::Unseen, _) => {
+                        edit.replace(i, Value::Const(boolean(parts, false, m)?));
+                    }
+                    (Space::Many(how, _), _) => return Err(refused(how)),
+                }
+                continue;
+            }
+        }
+        // Every other instruction: its generic result its group's type, its generic constants
+        // that type's, and each aggregate constant holding generic pointers each the space its
+        // leaf brings.
+        let holds = |parts: &ModuleParts, v: Value| match (v, plan.leaves.as_ref()) {
+            (Value::Const(c), Some(l)) => parts
+                .consts
+                .ty(c)
+                .is_some_and(|t| !generic_of(parts, v) && l.counted(parts, t).unwrap_or(0) > 0),
+            _ => false,
+        };
+        let mut constants = false;
+        inst.kind.for_each_value(|v| {
+            constants |= matches!(v, Value::Const(_)) && (generic_of(parts, v) || holds(parts, v));
+        });
+        let shared = result_generic || shares_in(parts, body, (name, params), &inst.kind);
+        if constants {
+            let mut kind = inst.kind.clone();
+            let mut failed = None;
+            let mut values: Vec<(Value, AddrSpace)> = Vec::new();
+            kind.for_each_value(|v| {
+                if let Value::Const(c) = v {
+                    if generic_of(parts, v) {
+                        let s = if shared {
+                            taken(own)
+                        } else {
+                            match (Cx {
+                                name,
+                                body,
+                                parts,
+                                params,
+                            })
+                            .constant(c, 0)
+                            {
+                                Ok((Space::Many(how, _), _)) => {
+                                    failed.get_or_insert(refused(how));
+                                    AddrSpace::Thread
+                                }
+                                Ok((s, _)) => taken(s),
+                                Err(e) => {
+                                    failed.get_or_insert(e);
+                                    AddrSpace::Thread
+                                }
+                            }
+                        };
+                        values.push((v, s));
+                    }
+                }
+            });
+            if let Some(e) = failed {
+                return Err(e);
+            }
+            let mut mapped: Vec<(ConstId, ConstId)> = Vec::new();
+            for (v, s) in values {
+                if let Value::Const(c) = v {
+                    if !mapped.iter().any(|(k, _)| *k == c) {
+                        mapped.push((c, retyped(parts, &mut interned, c, s, 0, m)?));
+                    }
+                }
+            }
+            let mut aggregates: Vec<ConstId> = Vec::new();
+            kind.for_each_value(|v| {
+                if let (Value::Const(c), true) = (v, holds(parts, v)) {
+                    aggregates.push(c);
+                }
+            });
+            for c in aggregates {
+                if mapped.iter().any(|(k, _)| *k == c) {
+                    continue;
+                }
+                let (Some(leaves), Some(old)) = (plan.leaves.as_ref(), parts.consts.ty(c)) else {
+                    continue;
+                };
+                let cx = Cx {
+                    name,
+                    body,
+                    parts,
+                    params,
+                };
+                let Some(spaces) = leaves::own_spaces(&cx, leaves, c)? else {
+                    continue;
+                };
+                let mut r = leaves::Retyped {
+                    leaves,
+                    interned: &mut interned,
+                };
+                let t = r.ty(parts, old, &spaces, m)?;
+                mapped.push((c, r.constant(parts, c, t, &spaces, m)?));
+            }
+            kind.for_each_value_mut(|v| {
+                if let Value::Const(c) = *v {
+                    if let Some(&(_, n)) = mapped.iter().find(|(k, _)| *k == c) {
+                        *v = Value::Const(n);
+                    }
+                }
+            });
+            edit.rewrite.insert(i, kind);
+        }
+        if result_generic {
+            let t = interned.ptr(parts, taken(own), m)?;
+            edit.retype.insert(i, t);
+        }
+    }
+    sweep(body, parts, &mut edit, m, held)?;
+    apply(body, &edit, &|c| c, m)
+}
+
+/// Delete the generic pointers `edit` leaves without a use: those only answered queries read, and
+/// what only those read. Each computes an address and nothing else (a `getelementptr`, a cast, a
+/// `freeze`, a `phi` or a `select`).
+fn sweep(
+    body: &Body,
+    parts: &ModuleParts,
+    edit: &mut BodyEdit,
+    m: &mut Meter,
+    held: &mut usize,
+) -> Result<(), Error> {
+    let n = body.insts.len();
+    let mut candidate: Vec<bool> = filled(m, held, n, false)?;
+    for (i, inst) in body.insts.iter() {
+        m.tick(1)?;
+        let generic = matches!(
+            parts.types.get(inst.ty),
+            Some(Type::Ptr {
+                space: AddrSpace::Generic
+            })
+        );
+        let address = matches!(
+            inst.kind,
+            InstKind::Gep { .. }
+                | InstKind::Cast {
+                    op: CastOp::Bitcast | CastOp::AddrSpaceCast,
+                    ..
+                }
+                | InstKind::Freeze(_)
+                | InstKind::Phi { .. }
+                | InstKind::Select { .. }
+        );
+        let replaced = edit.replace.get(i.index()).is_some_and(Option::is_some);
+        if let Some(slot) = candidate.get_mut(i.index()) {
+            *slot = generic && address && !replaced;
+        }
+    }
+    // Live: what a surviving instruction that is no candidate reads, and what a live candidate
+    // reads; each candidate enters the stack once.
+    let mut live: Vec<bool> = filled(m, held, n, false)?;
+    let mut stack: Vec<InstId> = filled(m, held, n, InstId::new(0))?;
+    stack.clear();
+    let mut failed = None;
+    let mut mark = |v: Value, live: &mut Vec<bool>, stack: &mut Vec<InstId>| {
+        let mut v = v;
+        for _ in 0..=n {
+            let Value::Inst(j) = v else { return };
+            match edit.replace.get(j.index()).copied().flatten() {
+                Some(next) => v = next,
+                None => {
+                    if candidate.get(j.index()).copied().unwrap_or(false)
+                        && !live.get(j.index()).copied().unwrap_or(true)
+                    {
+                        if let Some(slot) = live.get_mut(j.index()) {
+                            *slot = true;
+                        }
+                        stack.push(j);
+                    }
+                    return;
+                }
+            }
+        }
+        failed.get_or_insert_with(|| invariant("instruction replacements form a cycle"));
+    };
+    for (i, inst) in body.insts.iter() {
+        m.tick(1)?;
+        let gone = edit.replace.get(i.index()).is_some_and(Option::is_some)
+            || edit.delete.get(i.index()).copied().unwrap_or(false)
+            || candidate.get(i.index()).copied().unwrap_or(false);
+        if gone {
+            continue;
+        }
+        let kind = edit.rewrite.get(&i).unwrap_or(&inst.kind);
+        kind.for_each_value(|v| mark(v, &mut live, &mut stack));
+    }
+    while let Some(j) = stack.pop() {
+        m.tick(1)?;
+        let inst = body
+            .insts
+            .get(j)
+            .ok_or_else(|| invariant("instruction out of range"))?;
+        let kind = edit.rewrite.get(&j).unwrap_or(&inst.kind);
+        kind.for_each_value(|v| mark(v, &mut live, &mut stack));
+    }
+    if let Some(e) = failed {
+        return Err(e);
+    }
+    for k in 0..n {
+        if candidate.get(k).copied().unwrap_or(false) && !live.get(k).copied().unwrap_or(true) {
+            edit.delete(InstId::new(
+                u32::try_from(k).map_err(|_| invariant("instruction ids past u32"))?,
+            ));
+        }
+    }
+    Ok(())
+}
+
+/// A null pointer of space `s`.
+fn retyped_null(
+    parts: &mut ModuleParts,
+    interned: &mut Interned,
+    s: AddrSpace,
+    m: &mut Meter,
+) -> Result<ConstId, Error> {
+    let ty = interned.ptr(parts, s, m)?;
+    parts.consts.intern(
+        Constant {
+            ty,
+            value: Const::Null,
+        },
+        m,
+    )
+}
+
+/// [`shares`] over the module's tables alone.
+fn shares_in(
+    parts: &ModuleParts,
+    body: &Body,
+    (name, params): (&DiagName, &[TypeId]),
+    kind: &InstKind,
+) -> bool {
+    shares(
+        &Cx {
+            name,
+            body,
+            parts,
+            params,
+        },
+        kind,
+    )
+}
diff --git a/crates/metal2vulkan-air/src/canon/generic/cells.rs b/crates/metal2vulkan-air/src/canon/generic/cells.rs
--- a/crates/metal2vulkan-air/src/canon/generic/cells.rs
+++ b/crates/metal2vulkan-air/src/canon/generic/cells.rs
@@ -1,726 +1,972 @@
-//! Thread memory that generic pointers pass through: an allocation whose every access is visible
-//! holds, at each slot where a generic pointer is stored, the pointers stored there, so a generic
-//! pointer loaded from the slot is in their group.
-//!
-//! A *cell* is an `alloca` that a generic pointer is loaded from or stored into. Its address
-//! reaches each use through `getelementptr`s, bitcasts, `freeze`s and casts between the thread and
-//! the generic space, at a byte offset from the cell's start that is a translation-time constant
-//! or unknown. A generic access at a constant offset is at that offset's *slot*; one at an unknown
-//! offset may be at any slot of its cell, and the cell's slots then share one group.
-//!
-//! An address also reaches its uses through thread memory: a thread pointer stored into a
-//! *followed* slot and loaded back is the address stored ([`follow`]), as a lambda that captures
-//! a struct by reference holds the struct's address, and its call operator, inlined, loads it
-//! from the lambda's object to read the struct's fields. A slot is followed where every pointer
-//! stored into it is the address of one `alloca` at one offset (null among them or not), no other
-//! write, copy or read at another offset or width meets its bytes, and no use of its own
-//! `alloca`'s address is other than an access or address arithmetic. Storing an address into a
-//! followed slot is no use of it that leaves the translation's sight.
-//!
-//! A cell is *open*, and a generic pointer loaded from it has a space only the run knows
-//! ([`GenericPointer::Memory`]), where a use of its address is other than a load's or a store's
-//! address, a memory intrinsic's destination or source, a comparison or address arithmetic (the
-//! address stored as a value into a slot not followed, cast to an integer or to another space,
-//! passed to another call, merged by a `phi` or a `select`, or held in an aggregate), or where
-//! bytes other than a generic pointer's may be read as one: two slots overlap, a write of
-//! anything else (a store of another type, an atomic operation, a copy or a `memset`) overlaps a
-//! slot or writes bytes the translation cannot place, or a generic access at an unknown offset
-//! meets any such write.
-//!
-//! [`GenericPointer::Memory`]: crate::error::GenericPointer::Memory
-
-use crate::budget::Meter;
-use crate::error::Error;
-use crate::intrinsics::LlvmIntrinsic;
-use crate::ir::Value;
-use crate::ir::{
-    AddrSpace, Callee, CastOp, Const, Idx, InstId, InstKind, Layout, Type, TypeId, TypeLayouts,
-};
-
-use super::super::pieces::{gep_offset, int};
-use super::super::rewrite::{filled, invariant};
-use super::Cx;
-
-/// No cell.
-const NONE: u32 = u32::MAX;
-
-/// Where an address lies: in the `alloca` it is an instruction of, at a byte offset from its
-/// start (`None` where not a translation-time constant).
-type Place = Option<(u32, Option<u64>)>;
-
-/// A slot of an `alloca` that thread pointers pass through: the `alloca`'s index and the slot's
-/// byte offset.
-type Slot = (u32, u64);
-
-/// The followed slots, sorted, each with the address every pointer stored there is
-/// ([`follow`]).
-type Followed = Vec<(Slot, (u32, Option<u64>))>;
-
-/// The generic loads and stores of thread allocations, and the slots they reach.
-pub(super) struct Cells {
-    /// Each generic load or store of a cell, in instruction order, and the slot it reaches:
-    /// `None` where its cell is open.
-    reach: Vec<(InstId, Option<u32>)>,
-    /// How many slots there are.
-    pub slots: usize,
-    /// Slots in one group: an access at an unknown offset and each slot of its cell.
-    pub links: Vec<(u32, u32)>,
-}
-
-impl Cells {
-    /// The slot generic load or store `i` reaches: `None` where `i` is no generic access of a
-    /// cell, `Some(None)` where its cell is open.
-    pub fn reach(&self, i: InstId) -> Option<Option<u32>> {
-        self.reach
-            .binary_search_by_key(&i, |&(j, _)| j)
-            .ok()
-            .and_then(|k| self.reach.get(k))
-            .map(|&(_, s)| s)
-    }
-}
-
-/// One cell's accesses: the generic accesses' offsets, and the writes of other bytes.
-#[derive(Clone, Default)]
-struct Cell {
-    /// Whether some use of its address is no access.
-    open: bool,
-    /// The constant offsets of its generic accesses.
-    slots: Vec<u64>,
-    /// Whether a generic access lies at an unknown offset.
-    anywhere: bool,
-    /// The byte ranges other writes cover; `None` for one the translation cannot place.
-    writes: Vec<Option<(u64, u64)>>,
-}
-
-/// The cells of the entry's body, `None` when no generic pointer is loaded from or stored into
-/// an `alloca`.
-pub(super) fn find(cx: &Cx<'_>, m: &mut Meter, held: &mut usize) -> Result<Option<Cells>, Error> {
-    let mut accesses = false;
-    for inst in cx.body.insts.values() {
-        m.tick(1)?;
-        accesses |= generic_access(cx, &inst.kind, inst.ty).is_some();
-    }
-    if !accesses {
-        return Ok(None);
-    }
-    let layouts = TypeLayouts::new(&cx.parts.data_layout, &cx.parts.types, m)?;
-    let found = followed_places(cx, &layouts, m, held)
-        .and_then(|(place, followed)| cells(cx, &layouts, (&place, &followed), m, held));
-    m.release(cx.parts.types.len() * std::mem::size_of::<Option<Layout>>());
-    found
-}
-
-/// The address a generic load or store accesses.
-fn generic_access(cx: &Cx<'_>, kind: &InstKind, ty: TypeId) -> Option<Value> {
-    match kind {
-        InstKind::Load { ptr, .. } if cx.generic(ty) => Some(*ptr),
-        InstKind::Store { val, ptr, .. } if cx.is_generic(*val) => Some(*ptr),
-        _ => None,
-    }
-}
-
-/// Whether `ty` is a thread pointer.
-fn thread(cx: &Cx<'_>, ty: TypeId) -> bool {
-    matches!(
-        cx.parts.types.get(ty),
-        Some(Type::Ptr {
-            space: AddrSpace::Thread
-        })
-    )
-}
-
-/// Whether `kind` stores a thread pointer.
-fn pointer_store(cx: &Cx<'_>, kind: &InstKind) -> bool {
-    matches!(kind, InstKind::Store { val, .. } if cx.ty(*val).is_some_and(|t| thread(cx, t)))
-}
-
-/// Whether an `addrspacecast` of `v` to `ty` goes between the thread and the generic space, so
-/// its result points where `v` does.
-fn thread_generic(cx: &Cx<'_>, v: Value, ty: TypeId) -> bool {
-    let Some(from) = cx.ty(v) else {
-        return false;
-    };
-    (thread(cx, from) && cx.generic(ty)) || (cx.generic(from) && thread(cx, ty))
-}
-
-/// Whether `v` is a null pointer constant.
-fn null(cx: &Cx<'_>, v: Value) -> bool {
-    match v {
-        Value::Const(c) => matches!(cx.parts.consts.get(c).map(|k| &k.value), Some(Const::Null)),
-        _ => false,
-    }
-}
-
-/// Each instruction's [`Place`] and the slots followed, found together: the slots [`follow`]
-/// takes from the places so far, then the places they lead to, until neither changes. A slot
-/// followed once and not after is never followed again, so the rounds end; past their bound no
-/// slot is followed.
-fn followed_places(
-    cx: &Cx<'_>,
-    layouts: &TypeLayouts,
-    m: &mut Meter,
-    held: &mut usize,
-) -> Result<(Vec<Place>, Followed), Error> {
-    let stores = cx
-        .body
-        .insts
-        .values()
-        .filter(|inst| pointer_store(cx, &inst.kind))
-        .count();
-    let mut followed = Followed::new();
-    let mut ruled_out: Vec<Slot> = Vec::new();
-    for _ in 0..=2 * stores + 1 {
-        let place = places(cx, layouts, &followed, m, held)?;
-        let next = follow(cx, layouts, (&place, &followed, &ruled_out), m, held)?;
-        if next == followed {
-            give_back(m, held, next);
-            give_back(m, held, ruled_out);
-            return Ok((place, followed));
-        }
-        for &(slot, _) in &followed {
-            if next.binary_search_by_key(&slot, |&(s, _)| s).is_err() {
-                m.reserve(&mut ruled_out, 1)?;
-                *held = held.saturating_add(std::mem::size_of::<Slot>());
-                ruled_out.push(slot);
-            }
-        }
-        ruled_out.sort_unstable();
-        ruled_out.dedup();
-        give_back(m, held, place);
-        give_back(m, held, followed);
-        followed = next;
-    }
-    give_back(m, held, followed);
-    give_back(m, held, ruled_out);
-    let none = Followed::new();
-    Ok((places(cx, layouts, &none, m, held)?, none))
-}
-
-/// Give back what the meter charged for `v`: its elements, each charged as [`filled`] and a
-/// one-element `reserve` charge them.
-fn give_back<T>(m: &mut Meter, held: &mut usize, v: Vec<T>) {
-    let bytes = v.len().saturating_mul(std::mem::size_of::<T>());
-    m.release(bytes);
-    *held = held.saturating_sub(bytes);
-}
-
-/// Each instruction's [`Place`]: an `alloca`'s start, what a `getelementptr`, a bitcast, a
-/// `freeze` or a cast between the thread and the generic space derives from an address that has
-/// one, and a thread pointer loaded from a slot of `followed`. Passes run in instruction order
-/// until none changes, so an operand defined later is placed too.
-fn places(
-    cx: &Cx<'_>,
-    layouts: &TypeLayouts,
-    followed: &Followed,
-    m: &mut Meter,
-    held: &mut usize,
-) -> Result<Vec<Place>, Error> {
-    let n = cx.body.insts.len();
-    let mut place: Vec<Place> = filled(m, held, n, None)?;
-    let mut changed = true;
-    let mut rounds = 0;
-    while changed {
-        changed = false;
-        rounds += 1;
-        if rounds > n + 1 {
-            return Err(invariant("address derivations do not settle"));
-        }
-        for (i, inst) in cx.body.insts.iter() {
-            m.tick(1)?;
-            let of = |v: Value| match v {
-                Value::Inst(j) => place.get(j.index()).copied().flatten(),
-                _ => None,
-            };
-            let p = match &inst.kind {
-                InstKind::Alloca { .. } => {
-                    let k = u32::try_from(i.index()).map_err(|_| invariant("ids past u32"))?;
-                    Some((k, Some(0)))
-                }
-                InstKind::Gep {
-                    src_ty,
-                    base,
-                    indices,
-                    ..
-                } => of(*base).map(|(a, at)| {
-                    let step = gep_offset(cx.parts, layouts, *src_ty, indices);
-                    (a, at.zip(step).and_then(|(x, y)| x.checked_add(y)))
-                }),
-                InstKind::Cast {
-                    op: CastOp::Bitcast,
-                    v,
-                }
-                | InstKind::Freeze(v) => of(*v),
-                InstKind::Cast {
-                    op: CastOp::AddrSpaceCast,
-                    v,
-                } if thread_generic(cx, *v, inst.ty) => of(*v),
-                InstKind::Load { ptr, .. } if thread(cx, inst.ty) => match of(*ptr) {
-                    Some((a, Some(at))) => followed
-                        .binary_search_by_key(&(a, at), |&(s, _)| s)
-                        .ok()
-                        .and_then(|k| followed.get(k))
-                        .map(|&(_, to)| to),
-                    _ => None,
-                },
-                _ => None,
-            };
-            if let Some(slot) = place.get_mut(i.index()) {
-                if *slot != p {
-                    *slot = p;
-                    changed = true;
-                }
-            }
-        }
-    }
-    Ok(place)
-}
-
-/// One slot thread pointers may pass through: where the pointers stored into it point, while
-/// they agree, and whether anything rules it out.
-struct Candidate {
-    slot: Slot,
-    to: Option<(u32, Option<u64>)>,
-    ok: bool,
-}
-
-/// The slots thread pointers pass through, under `place` and the slots `followed` so far (the
-/// module docs): an `alloca`'s slot at a constant offset that a thread pointer is stored into,
-/// whose stores all store a null or the address of one `alloca` at one offset, that no other
-/// store, atomic operation, copy, `memset` or load at another offset or width meets (a load or
-/// a copy of the bytes elsewhere reads them as no pointer the translation follows), that no
-/// other such slot overlaps, of an `alloca` whose address no use but an access and address
-/// arithmetic takes (a store of it into a slot of `followed` among them). No slot of
-/// `ruled_out` is one.
-fn follow(
-    cx: &Cx<'_>,
-    layouts: &TypeLayouts,
-    (place, followed, ruled_out): (&[Place], &Followed, &[Slot]),
-    m: &mut Meter,
-    held: &mut usize,
-) -> Result<Followed, Error> {
-    let n = cx.body.insts.len();
-    let at = |v: Value| match v {
-        Value::Inst(j) => place.get(j.index()).copied().flatten(),
-        _ => None,
-    };
-    let width = u64::from(
-        cx.parts
-            .data_layout
-            .pointer(AddrSpace::Thread.raw())
-            .size_bits
-            .div_ceil(8),
-    );
-    let mut candidates: Vec<Candidate> = Vec::new();
-    for inst in cx.body.insts.values() {
-        m.tick(1)?;
-        let InstKind::Store { val, ptr, .. } = &inst.kind else {
-            continue;
-        };
-        if !cx.ty(*val).is_some_and(|t| thread(cx, t)) {
-            continue;
-        }
-        let Some((a, Some(off))) = at(*ptr) else {
-            continue;
-        };
-        if ruled_out.binary_search(&(a, off)).is_ok() {
-            continue;
-        }
-        m.reserve(&mut candidates, 1)?;
-        *held = held.saturating_add(std::mem::size_of::<Candidate>());
-        let to = at(*val);
-        let ok = to.is_some() || null(cx, *val);
-        candidates.push(Candidate {
-            slot: (a, off),
-            to,
-            ok,
-        });
-    }
-    if candidates.is_empty() {
-        return Ok(Followed::new());
-    }
-    // One candidate a slot: its stores' addresses agree, and a null joins any.
-    candidates.sort_by_key(|c| c.slot);
-    let stored = candidates
-        .len()
-        .saturating_mul(std::mem::size_of::<Candidate>());
-    let mut merged: Vec<Candidate> = Vec::new();
-    for c in candidates {
-        match merged.last_mut() {
-            Some(last) if last.slot == c.slot => {
-                last.ok &= c.ok;
-                match (last.to, c.to) {
-                    (Some(x), Some(y)) if x != y => last.ok = false,
-                    (None, y) => last.to = y,
-                    _ => {}
-                }
-            }
-            _ => {
-                m.reserve(&mut merged, 1)?;
-                *held = held.saturating_add(std::mem::size_of::<Candidate>());
-                merged.push(c);
-            }
-        }
-    }
-    m.release(stored);
-    *held = held.saturating_sub(stored);
-    // Two slots of one `alloca` whose pointers overlap.
-    for k in 1..merged.len() {
-        let (before, after) = merged.split_at_mut(k);
-        if let (Some(a), Some(b)) = (before.last_mut(), after.first_mut()) {
-            if a.slot.0 == b.slot.0 && b.slot.1 - a.slot.1 < width {
-                a.ok = false;
-                b.ok = false;
-            }
-        }
-    }
-    // Rule out the candidates that `(a, off, len)` meets: every one of `a` where the offset or
-    // the length is unknown.
-    let meets = |merged: &mut [Candidate], (a, off, len): (u32, Option<u64>, Option<u64>)| {
-        let lo = merged.partition_point(|c| c.slot.0 < a);
-        let rest = merged.get_mut(lo..).unwrap_or_default();
-        for c in rest.iter_mut().take_while(|c| c.slot.0 == a) {
-            let hit = match off.zip(len) {
-                Some((o, l)) => {
-                    o < c.slot.1.saturating_add(width) && c.slot.1 < o.saturating_add(l)
-                }
-                None => true,
-            };
-            if hit {
-                c.ok = false;
-            }
-        }
-    };
-    let size = |v: Value| cx.ty(v).and_then(|t| layouts.store_size(t));
-    let mut open: Vec<bool> = filled(m, held, n, false)?;
-    let exempt = |ptr: Value| {
-        at(ptr).is_some_and(|(a, off)| {
-            off.is_some_and(|o| followed.binary_search_by_key(&(a, o), |&(s, _)| s).is_ok())
-        })
-    };
-    for inst in cx.body.insts.values() {
-        m.tick(1)?;
-        match &inst.kind {
-            InstKind::Store { val, ptr, .. } => {
-                let pointer = cx.ty(*val).is_some_and(|t| thread(cx, t));
-                if let Some((a, off)) = at(*ptr) {
-                    if !pointer || off.is_none() {
-                        meets(&mut merged, (a, off, size(*val)));
-                    }
-                }
-            }
-            InstKind::Load { ptr, .. } => {
-                if let Some((a, off)) = at(*ptr) {
-                    let pointer = thread(cx, inst.ty) && off.is_some();
-                    let exact =
-                        pointer && off.is_some_and(|o| merged.iter().any(|c| c.slot == (a, o)));
-                    if !exact {
-                        meets(&mut merged, (a, off, layouts.store_size(inst.ty)));
-                    }
-                }
-            }
-            InstKind::AtomicRmw { ptr, val, .. } => {
-                if let Some((a, off)) = at(*ptr) {
-                    meets(&mut merged, (a, off, size(*val)));
-                }
-            }
-            InstKind::CmpXchg { ptr, new, .. } => {
-                if let Some((a, off)) = at(*ptr) {
-                    meets(&mut merged, (a, off, size(*new)));
-                }
-            }
-            InstKind::Call(call) => {
-                if let (
-                    Callee::Llvm {
-                        op:
-                            LlvmIntrinsic::Memset { .. }
-                            | LlvmIntrinsic::Memcpy { .. }
-                            | LlvmIntrinsic::Memmove { .. },
-                        ..
-                    },
-                    [dst, src, len, ..],
-                ) = (&call.callee, &*call.args)
-                {
-                    let len = int(cx.parts, *len);
-                    for v in [*dst, *src] {
-                        if let Some((a, off)) = at(v) {
-                            meets(&mut merged, (a, off, len));
-                        }
-                    }
-                }
-            }
-            _ => {}
-        }
-        uses(cx, layouts, (&inst.kind, inst.ty), &exempt, |u| {
-            if let Use::Escape(v) = u {
-                if let Some((a, _)) = at(v) {
-                    if let Some(o) = open.get_mut(a as usize) {
-                        *o = true;
-                    }
-                }
-            }
-        });
-    }
-    let mut next = Followed::new();
-    for c in &merged {
-        let closed = !open.get(c.slot.0 as usize).copied().unwrap_or(true);
-        if let (true, true, Some(to)) = (c.ok, closed, c.to) {
-            m.reserve(&mut next, 1)?;
-            *held = held.saturating_add(std::mem::size_of::<(Slot, (u32, Option<u64>))>());
-            next.push((c.slot, to));
-        }
-    }
-    give_back(m, held, merged);
-    give_back(m, held, open);
-    Ok(next)
-}
-
-fn cells(
-    cx: &Cx<'_>,
-    layouts: &TypeLayouts,
-    (place, followed): (&[Place], &Followed),
-    m: &mut Meter,
-    held: &mut usize,
-) -> Result<Option<Cells>, Error> {
-    let n = cx.body.insts.len();
-    let at = |v: Value| match v {
-        Value::Inst(j) => place.get(j.index()).copied().flatten(),
-        _ => None,
-    };
-    // Each cell's index, by its `alloca`.
-    let mut index: Vec<u32> = filled(m, held, n, NONE)?;
-    let mut table: Vec<Cell> = Vec::new();
-    let mut generic: Vec<(InstId, u32, Option<u64>)> = Vec::new();
-    for (i, inst) in cx.body.insts.iter() {
-        m.tick(1)?;
-        let Some((a, off)) = generic_access(cx, &inst.kind, inst.ty).and_then(at) else {
-            continue;
-        };
-        let slot = index
-            .get_mut(a as usize)
-            .ok_or_else(|| invariant("an alloca out of range"))?;
-        if *slot == NONE {
-            *slot = u32::try_from(table.len()).map_err(|_| invariant("cells past u32"))?;
-            m.reserve(&mut table, 1)?;
-            *held = held.saturating_add(std::mem::size_of::<Cell>());
-            table.push(Cell::default());
-        }
-        m.reserve(&mut generic, 1)?;
-        *held = held.saturating_add(std::mem::size_of::<(InstId, u32, Option<u64>)>());
-        generic.push((i, *slot, off));
-    }
-    if generic.is_empty() {
-        return Ok(None);
-    }
-    // The cell an address is in, and its offset there.
-    let cell_of = |v: Value| -> Option<(u32, Option<u64>)> {
-        let (a, off) = at(v)?;
-        let c = *index.get(a as usize)?;
-        (c != NONE).then_some((c, off))
-    };
-    let exempt = |ptr: Value| {
-        at(ptr).is_some_and(|(a, off)| {
-            off.is_some_and(|o| followed.binary_search_by_key(&(a, o), |&(s, _)| s).is_ok())
-        })
-    };
-    let mut failed = None;
-    for inst in cx.body.insts.values() {
-        m.tick(1)?;
-        uses(cx, layouts, (&inst.kind, inst.ty), &exempt, |u| {
-            let (v, write) = match u {
-                Use::Escape(v) => (v, None),
-                Use::Write(v, len) => (v, Some(len)),
-            };
-            let Some((c, off)) = cell_of(v) else { return };
-            let Some(cell) = table.get_mut(c as usize) else {
-                return;
-            };
-            match write {
-                None => cell.open = true,
-                Some(len) => {
-                    let range = off
-                        .zip(len)
-                        .and_then(|(lo, len)| Some((lo, lo.checked_add(len)?)));
-                    if let Err(e) = m.reserve(&mut cell.writes, 1) {
-                        failed.get_or_insert(e);
-                        return;
-                    }
-                    *held = held.saturating_add(std::mem::size_of::<Option<(u64, u64)>>());
-                    cell.writes.push(range);
-                }
-            }
-        });
-        if let Some(e) = failed.take() {
-            return Err(e);
-        }
-    }
-    for &(_, c, off) in &generic {
-        let cell = table
-            .get_mut(c as usize)
-            .ok_or_else(|| invariant("a cell out of range"))?;
-        match off {
-            Some(o) => {
-                m.reserve(&mut cell.slots, 1)?;
-                *held = held.saturating_add(std::mem::size_of::<u64>());
-                cell.slots.push(o);
-            }
-            None => cell.anywhere = true,
-        }
-    }
-    // A generic pointer's bytes.
-    let width = u64::from(
-        cx.parts
-            .data_layout
-            .pointer(AddrSpace::Generic.raw())
-            .size_bits
-            .div_ceil(8),
-    );
-    // Slot nodes: each cell's distinct offsets, then one for an access at an unknown offset.
-    let mut first: Vec<u32> = Vec::new();
-    m.reserve(&mut first, table.len())?;
-    *held = held.saturating_add(table.len() * std::mem::size_of::<u32>());
-    let mut slots = 0u32;
-    let mut links = Vec::new();
-    for cell in &mut table {
-        m.tick(1)?;
-        cell.slots.sort_unstable();
-        cell.slots.dedup();
-        cell.open |= !disciplined(cell, width);
-        first.push(slots);
-        let count = u32::try_from(cell.slots.len() + usize::from(cell.anywhere))
-            .map_err(|_| invariant("slots past u32"))?;
-        if cell.anywhere && !cell.open {
-            let any = slots + count - 1;
-            for k in 0..count - 1 {
-                m.reserve(&mut links, 1)?;
-                *held = held.saturating_add(std::mem::size_of::<(u32, u32)>());
-                links.push((slots + k, any));
-            }
-        }
-        slots = slots
-            .checked_add(count)

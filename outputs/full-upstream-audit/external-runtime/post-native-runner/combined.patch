+/// A static initializer's branch on an unsupplied constant takes its false way: the store it
+/// guards does not run.
+#[test]
+fn a_static_initializer_branch_on_an_unsupplied_constant_takes_its_false_way() {
+    let mut m = ModuleBuilder::new();
+    let void = m.void();
+    let i1 = m.int(1);
+    let i8t = m.int(8);
+    let flag = fc_global(&mut m, "flag", i8t);
+    let zero = m.constant(i8t, Const::Int(0));
+    let g = m.simple_global("g", i8t, AddrSpace::Constant, Some(zero));
+    let (faddr, gaddr) = (m.global_addr(flag), m.global_addr(g));
+    let fty = m.fn_ty(void, &[]);
+    let mut init = m.define("init", fty);
+    let (t, e) = (init.block(), init.block());
+    let v = load(&mut init, i8t, faddr);
+    let c = init.push(
+        i1,
+        InstKind::Cast {
+            op: CastOp::Trunc,
+            v,
+        },
+    );
+    init.cond_br(c, t, e);
+    init.switch_to(t);
+    store(&mut init, v, gaddr);
+    init.br(e);
+    init.switch_to(e);
+    init.ret(None);
+    let init = init.finish();
+    m.func_mut(init).unwrap().section = Some(Section::StaticInit);
+    let mut f = m.define("k", fty);
+    f.ret(None);
+    let k = f.finish();
+    let module = m.finish().unwrap();
+    let abi = abi(vec![kernel(k, Vec::new())], vec![fc_decl(3, flag, i8t)]);
+    specialize(module.clone(), &abi, &request(&[]), &mut meter()).unwrap();
+    let unsupplied = static_values(module.clone(), &abi, &BTreeMap::new(), &[g], &mut meter());
+    assert_eq!(unsupplied.unwrap(), [Ok(0)]);
+    let on = static_values(
+        module.clone(),
+        &abi,
+        &[(3, boolean(1))].into(),
+        &[g],
+        &mut meter(),
+    );
+    assert_eq!(on.unwrap(), [Ok(1)]);
+    let r = SpecRequest {
+        call_stack_depth: 1,
+        open_cl_mode: false,
+        entry: "k".into(),
+        constants: [(3, boolean(1))].into_iter().collect(),
+    };
+    specialize(module, &abi, &r, &mut meter()).unwrap();
+}

-    /// Run one fold, then return the ledger bytes its temporary lists held.
-    fn transient<R>(
-        &mut self,
-        m: &mut Meter,
-        fold: impl FnOnce(&mut Self, &mut Meter) -> Result<R, Error>,
-    ) -> Result<R, Error> {
-        let r = fold(self, m);
-        m.release(self.held);
-        self.held = 0;
-        r
-    }

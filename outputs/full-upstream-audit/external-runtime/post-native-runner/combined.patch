-    let (mut a, mut b) = (buffer(0, 0), buffer(1, 0));
-    a.role = first(at);
-    b.role = second(at);
-    if gated {
-        a.predicate = Some(Predicate {
-            global: p_off,
-            name: DiagName::new("p"),
-        });
-    }
-    let abi = abi(vec![kernel(k, vec![a, b])], vec![fc_decl(0, at, i32t)]);
-    specialize(module, &abi, &request(&[(0, int(n))]), &mut meter()).map(|_| ())
